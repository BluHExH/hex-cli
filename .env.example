# Copy to ~/.hex/.env or project .env (never commit real keys)
# HEX reads the first .env it finds: project/.env → cwd/.env → ~/.hex/.env

# OpenAI
OPENAI_API_KEY=sk-...

# OpenRouter (https://openrouter.ai)
OPENROUTER_API_KEY=sk-or-...

# Groq free tier (https://console.groq.com)
GROQ_API_KEY=gsk_...

# Ollama (optional; local models usually work without a key)
# OLLAMA_API_KEY=ollama
